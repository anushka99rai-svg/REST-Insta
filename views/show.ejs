<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post</title>
</head>
<body>
    <div class="post">
            <p>Id : <%=post.id %></p>
            <h4>Username : @<%=post.username %></h4>
            <img src="<%=post.img %>" alt="Post image">
            <h4><%=post.caption %></h4>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
    <h2 class="logo">Instagram</h2>
    <% for(post of posts){ %>
        <div class="post">
            <p>Id : <%=post.id %></p>
            <h4>Username : @<%=post.username %></h4>
            <img src="<%=post.img %>" alt="Post image">
            <h4><%=post.caption %></h4>
            <a href="http://localhost:8080/posts/<%=post.id %>" >See post</a>
            <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit post</a>
            <form method="POST" action="/posts/<%=post.id%>?_method=DELETE">
                  <button type="submit">Delete post</button>
            </form>
        </div>
    <% } %>
    <br>
    <a href="http://localhost:8080/posts/new">Create new Post</a>
</body>
</html>

